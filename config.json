{
  "timezone": "Asia/Shanghai",
  "daily_time": "09:00",
  "initial_lookback_days": 3,
  "overlap_hours": 48,
  "top_n": 10,
  "preferred_keywords": ["开源", "效率", "自动化", "独立开发", "工具", "workflow", "productivity", "open source", "automation"],
  "http_timeout_seconds": 25,
  "http_attempts": 3,
  "request_interval_seconds": 0.4,
  "max_requests_per_source": 200,
  "report": {
    "daily_feature_count": 4,
    "daily_insight_count": 2,
    "daily_max_chars": 6000,
    "repeat_suppression_days": 30
  },
  "llm": {
    "enabled": true,
    "provider": "deepseek",
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-flash",
    "api_key_env": "LLM_API_KEY",
    "focus": "关注产品的核心功能、定位、客户和衍生思考；优先个人或小团队可借鉴的产品。",
    "batch_size": 16,
    "concurrency": 3,
    "deep_dive_count": 12,
    "max_items_per_run": 1200,
    "max_calls_per_run": 120,
    "timeout_seconds": 240,
    "max_attempts": 2,
    "screen_max_tokens": 12000,
    "deep_max_tokens": 24000,
    "history_days": 7,
    "fetch_product_pages": true,
    "page_timeout_seconds": 18,
    "evidence_max_chars": 12000
  },
  "sources": [
    {
      "id": "show_hn",
      "name": "Show HN",
      "kind": "hn_search",
      "enabled": true,
